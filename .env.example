TG_API_ID=123456
TG_API_HASH=your_api_hash_here
FRONTEND_ORIGINS=http://localhost:5173,http://prok.services,https://prok.services
DB_PATH=backend/var/data.sqlite3
LOG_PATH=backend/var/logs/app.log
LOG_LEVEL=INFO
SESSION_ENC_KEY=replace_with_fernet_key
AUTH_FLOW_TTL_MINUTES=10
QR_TTL_SECONDS=180
QR_REFRESH_AFTER_SECONDS=120

# AI (DeepSeek, OpenAI-compatible)
# Do NOT commit real keys. Put your real key in `.env` on the server or set env vars.
DEEPSEEK_API_KEY=replace_with_deepseek_key
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_HTTP_TIMEOUT=120

# Telegram error alerts bot
# Example:
# TG_ALERT_BOT_TOKEN=123456789:AA...
# TG_ALERT_BOT_CHAT_IDS=-1001234567890,123456789
TG_ALERT_BOT_TOKEN=
TG_ALERT_BOT_CHAT_IDS=
TG_ALERT_BOT_POLL_TIMEOUT_SEC=30

# Key generation
