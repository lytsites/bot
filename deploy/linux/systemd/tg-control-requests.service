[Unit]
Description=TG Web Auth - Process service restart requests
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=/opt/tg-web-auth/backend
EnvironmentFile=/opt/tg-web-auth/.env
ExecStart=/opt/tg-web-auth/.venv/bin/python /opt/tg-web-auth/backend/scripts/process_restart_requests.py

